# Contrato de entorno estándar para Gymtec ERP
# Copiar a backend/config.env solo para desarrollo fuera de Docker.

# Base de datos
DB_HOST=mysql
DB_PORT=3306
DB_USER=gymtec_user
DB_PASSWORD=change-this-app-password
DB_NAME=gymtec_erp

# Servidor
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:8082

# Seguridad
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=10h
